{
  "name": "BusinessMembership",
  "type": "object",
  "properties": {
    "businessId": {
      "type": "string",
      "format": "uuid"
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "member"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    }
  },
  "required": [
    "businessId",
    "userId",
    "role",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}