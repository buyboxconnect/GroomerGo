{
  "name": "Business",
  "type": "object",
  "properties": {
    "businessId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "ownerUserId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disabled"
      ]
    }
  },
  "required": [
    "businessId",
    "name",
    "ownerUserId",
    "status"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}